# IOsense connector for the KNPL EMS deployment.
#
# Copy to .env.local and fill in. .env.local is gitignored — never commit a
# real token. Both variables are read on the server only: they are not
# prefixed NEXT_PUBLIC_, so Next.js will not inline them into the client
# bundle, and the browser never sees the token.

# Base URL, no trailing slash. Production (inside the Nerolac network):
#   http://knpl-ems-app.nerolac.com:3002/api
# IOsense hosted:
#   https://connector.iosense.io/api
IOSENSE_API_BASE_URL=

# Bearer token sent as `Authorization: Bearer <token>`.
IOSENSE_API_TOKEN=

# Optional `organisation` header, required by some endpoints (findUserDevices).
IOSENSE_ORGANISATION=

# Timezone used for time bucketing in getWidgetData.
IOSENSE_TIMEZONE=Asia/Calcutta

# Set to "simulation" to force the built-in demo data even when the above are
# configured. Any other value (or unset) uses IOsense when it is configured.
EMS_DATA_SOURCE=
